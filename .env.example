ORDERS_URL="https://www.phoenixnext.com/sales/order/history/?limit=50"
ORDERS_OUTPUT_FILE="orders.json"
ORDERS_DETAILS_FILE="orders-details.json"
ORDERS_EXCEL_FILE="orders.xlsx"

# Session cookie. Only PHPSESSID is required — it is the single cookie the
# site checks for both /sales/order/history/ and /sales/order/view/.
#
# HOW TO UPDATE:
#   1. Log in at https://www.phoenixnext.com
#   2. Open Chrome DevTools (F12) → Application tab
#   3. Storage → Cookies → https://www.phoenixnext.com
#   4. Find PHPSESSID and copy its Value column
#   5. Paste it below as PHPSESSID=<value>
#
# Pasting the entire `cookie:` request header also works — the value is sent
# through untouched — but the extra analytics cookies are ignored by the server.
ORDERS_COOKIE="PHPSESSID=your_session_id_here"

# Web UI server port (default: 3001)
SERVER_PORT=3001
